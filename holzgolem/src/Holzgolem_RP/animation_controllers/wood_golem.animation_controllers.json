{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.wood_golem.move": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [{ "walk": "query.modified_move_speed" }],
          "transitions": [{ "has_target": "query.has_target" }]
        },
        "has_target": {
          "animations": [{ "walk_to_target": "query.modified_move_speed" }],
          "transitions": [{ "default": "!query.has_target" }]
        }
      }
    },
    "controller.animation.wood_golem.arms": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["move"],
          "transitions": [{ "attack": "variable.attack_time > 0.0" }, { "has_target": "query.has_target" }]
        },
        "has_target": {
          "animations": ["move_to_target"],
          "transitions": [{ "attack": "variable.attack_time > 0.0" }, { "default": "!query.has_target" }]
        },
        "attack": {
          "animations": ["attack"],
          "transitions": [{ "default": "variable.attack_time <= 0.0" }]
        }
      }
    }
  }
}
